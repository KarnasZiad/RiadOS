NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# The API connects with a login role that is a member of riados_app: RLS applies to it.
DATABASE_URL=postgresql://riados_api:riados_api@localhost:5432/riados
# Migrations run with the schema owner.
DIRECT_URL=postgresql://riados_owner:riados_owner@localhost:5432/riados
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGINS=http://localhost:5173
# Local development runs over plain HTTP.
COOKIE_SECURE=false
